{
  "_comment": "All tunables live here. Put personal overrides in config.local.json (deep-merged on top).",
  "db_path": "data/trench.db",
  "demo_db_path": "data/trench_demo.db",
  "timezone_daily_hour": 8,

  "pipeline": {
    "lookback_days": 7,
    "runner_ath_usd": 100000,
    "ath_prefilter_usd": 40000,
    "cheap_refresh_min": 10,
    "ohlcv_refresh_min": 60,
    "deep_refresh_min": 30,
    "max_cheap_per_scan": 1500,
    "max_ohlcv_per_scan": 60,
    "max_deep_per_scan": 40,
    "total_supply": 1000000000,
    "cheap_scope": "candidates",
    "min_runner_holders": 50
  },

  "scheduler": {
    "scan_every_min": 10,
    "hourly_at_minute": 0,
    "daily_at_hour": 8
  },

  "signals": {
    "holders":   {"enabled": true, "required": true,  "min": 300},
    "top10":     {"enabled": true, "required": true,  "max_pct": 35},
    "fees":      {"enabled": true, "required": true, "allow_missing": true, "min_trade_sol": 0.1,
                  "min_fee_paying_volume_pct": 40, "min_fee_volume_pct": 0.3, "min_organic_score": 25},
    "kols":      {"enabled": true, "required": false, "min": 1},
    "traders":   {"enabled": true, "required": true,  "min": 150},
    "wash":      {"enabled": true, "required": true, "max_round_trip_pct": 60, "max_symmetric_pct": 35,
                  "max_same_size_pct": 35, "max_trades_per_trader": 8, "min_interval_cv": 0.35,
                  "max_volume_per_trader": 3000},
    "chart":     {"enabled": true, "required": true, "allow_missing": true, "max_staircase": 0.65, "cliff_staircase": 0.5}
  },

  "catalysts": {
    "kol_call_window_min": 60,
    "big_account_followers": 100000
  },

  "narratives": {
    "emerging_min_count": 2,
    "emerging_top_n": 10,
    "min_word_len": 3
  },

  "thesis": {
    "daily_window_h": 24,
    "daily_baseline_h": 72,
    "hourly_window_h": 1,
    "hourly_baseline_h": 6,
    "meta_shift_momentum": 2.0,
    "meta_shift_min_runners": 2,
    "avoid_min_launches": 15,
    "avoid_hit_rate_ratio": 0.5,
    "look_for_n": 4
  },

  "kol_research": {
    "refresh_h": 1,
    "min_holding_sol": 0.01,
    "max_holdings": 12,
    "helius_pages": 5,
    "rpc_url": "https://api.mainnet-beta.solana.com",
    "rpc_sample": 60
  },

  "llm": {
    "model": "claude-opus-5-5",
    "effort": "low",
    "max_tokens": 2000,
    "why_bullets": true,
    "thesis_prose": true
  },

  "sources": {
    "pumpfun": {
      "enabled": true,
      "base_urls": ["https://frontend-api-v3.pump.fun", "https://frontend-api-v2.pump.fun", "https://frontend-api.pump.fun"],
      "list_paths": [
        "/coins?offset={offset}&limit={limit}&sort={sort}&order=DESC&includeNsfw=true&complete={complete}",
        "/coins/for-you?offset={offset}&limit={limit}&includeNsfw=true"
      ],
      "detail_paths": ["/coins/{mint}", "/coins-v2/{mint}"],
      "sorts": ["created_timestamp", "market_cap", "last_trade_timestamp"],
      "page_limit": 50,
      "max_pages": 20,
      "rate_per_min": 60,
      "blocked_backoff_h": 6
    },
    "pumpportal": {"enabled": true, "url": "wss://pumpportal.fun/api/data"},
    "gecko_discovery": {"enabled": true, "pumpswap_pages": 10, "pumpswap_tx_pages": 5, "pumpfun_pages": 3},
    "dex_feeds": {"enabled": true},
    "jupiter": {"enabled": true, "base_url": "https://lite-api.jup.ag", "launchpads": ["pump.fun"], "rate_per_min": 50},
    "jupiter_tokens": {"enabled": true, "batch": 100, "rate_per_min": 50},
    "metadata": {"enabled": true, "gt_info_per_scan": 8},
    "dexscreener": {"enabled": true, "base_url": "https://api.dexscreener.com", "batch": 30, "rate_per_min": 250},
    "geckoterminal": {"enabled": true, "base_url": "https://api.geckoterminal.com/api/v2", "timeframe": "hour", "aggregate": 1, "limit": 200, "rate_per_min": 24},
    "helius_holders": {"enabled": true, "max_pages": 10, "rate_per_min": 120, "exclude_owners": []},
    "helius_txs": {"enabled": true, "sample_size": 100, "sample_pages": 5, "rate_per_min": 120},
    "solana_rpc": {"enabled": true, "rpc_url": "https://api.mainnet-beta.solana.com", "coins_per_scan": 6,
                   "sample_size": 40, "batch": 5, "rate_per_min": 12},
    "chart_shape": {"enabled": true, "aggregate": 1, "limit": 1000, "coins_per_scan": 12},
    "kols": {"enabled": true, "tx_limit": 100, "rate_per_min": 120},
    "twitter": {"enabled": true, "base_url": "https://api.x.com/2", "max_results": 50, "rate_per_min": 30},
    "demo": {"enabled": false, "launches_per_10min": 10, "seed": 1337, "scan_every_min": 1}
  }
}
