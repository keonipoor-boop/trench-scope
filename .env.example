# Copy to .env and fill in what you have. Everything is optional: with no keys,
# run `python run.py demo` to see the whole app on generated data.

# Helius (holders via DAS, enhanced transactions for fees/traders, KOL wallet swaps)
HELIUS_API_KEY=

# X / Twitter API v2 bearer token (mentions, top tweets, big-account detection)
X_BEARER_TOKEN=

# Claude: why-it-ran bullets + thesis prose. Template text is used when unset.
ANTHROPIC_API_KEY=

# Optional overrides
# TRENCH_DB=data/trench.db
# TRENCH_MODE=live        # live | demo
